# =============================================================================
# AspectVoice — Backend Environment Variables Example
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (at least one of Groq or Gemini is required)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# -----------------------------------------------------------------------------
# YouTube Data API v3
# Get one at: https://console.cloud.google.com/ -> APIs & Services -> YouTube Data API v3
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=AIza...

# -----------------------------------------------------------------------------
# Database (NeonDB Postgres)
# Format: postgresql://user:password@host/dbname?sslmode=require
# Get one at: https://neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Reddit API (optional -- pipeline skips Reddit source if not set)
# Register an app at: https://www.reddit.com/prefs/apps
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=aspectvoice/1.0

# -----------------------------------------------------------------------------
# Server settings (optional -- sensible defaults shown)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed origins for CORS (include your frontend URL)
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Scheduler (optional -- protects the /trigger endpoint if set)
# Set to any random secret string, e.g.: openssl rand -hex 32
# -----------------------------------------------------------------------------
SCHEDULER_SECRET=your_random_secret_here
